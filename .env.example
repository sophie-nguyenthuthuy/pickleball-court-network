# --- runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- core services ---
DATABASE_URL=postgresql://pcn:pcn@localhost:5432/pcn?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-32-byte-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
HASH_PEPPER=replace-with-random-pepper

# --- api ---
API_PORT=4000
API_HOST=0.0.0.0
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PUBLIC_API_URL=http://localhost:4000

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=REPLACE_ME

# --- payments: VNPay ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/booking/return/vnpay
VNPAY_IPN_URL=http://localhost:4000/webhooks/vnpay

# --- payments: MoMo ---
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_RETURN_URL=http://localhost:3000/booking/return/momo
MOMO_IPN_URL=http://localhost:4000/webhooks/momo

# --- payments: ZaloPay ---
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_CALLBACK_URL=http://localhost:4000/webhooks/zalopay

# --- zalo OA (chatbot / OTP / broadcast) ---
ZALO_OA_ID=
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_REFRESH_TOKEN=
ZALO_OA_SECRET=
ZALO_LOGIN_APP_ID=
ZALO_LOGIN_APP_SECRET=
ZALO_LOGIN_REDIRECT_URI=http://localhost:3000/auth/zalo/callback

# --- sms (eSMS, FPT) ---
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRAND_NAME=PCN

# --- object storage (Cloudflare R2 / MinIO) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=pcn-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# --- observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=pcn

# --- mobile push (Expo) ---
EXPO_PUSH_ACCESS_TOKEN=

# --- email (transactional, Resend or SES) ---
EMAIL_FROM=no-reply@pcn.vn
RESEND_API_KEY=
