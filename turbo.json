{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", ".env"],
  "globalEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "VNPAY_TMN_CODE",
    "VNPAY_HASH_SECRET",
    "VNPAY_URL",
    "MOMO_PARTNER_CODE",
    "MOMO_ACCESS_KEY",
    "MOMO_SECRET_KEY",
    "ZALOPAY_APP_ID",
    "ZALOPAY_KEY1",
    "ZALOPAY_KEY2",
    "ZALO_OA_ID",
    "ZALO_OA_ACCESS_TOKEN",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "SENTRY_DSN",
    "PUBLIC_API_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_MAP_TILE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": { "outputs": [] },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:unit": { "outputs": [] },
    "test:integration": { "outputs": [], "dependsOn": ["^build"] },
    "test:e2e": { "outputs": [], "dependsOn": ["^build"] },
    "clean": { "cache": false }
  }
}
