{
  "name": "@pcn/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@pcn/adapters": "workspace:*",
    "@pcn/config": "workspace:*",
    "@pcn/core": "workspace:*",
    "@pcn/db": "workspace:*",
    "@pcn/notifications": "workspace:*",
    "@pcn/observability": "workspace:*",
    "bullmq": "^5.10.4",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
